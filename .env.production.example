# Compose interpolation only. Keep application secrets in bot/.env and backend/.env.
# The shell overrides these values; prefer a full 40-character published commit SHA.
CONSOLE_IMAGE_NAMESPACE=sjkd23/console
CONSOLE_IMAGE_TAG=latest
# For an existing deployment, preserve its project name (do not invent a new one).
# COMPOSE_PROJECT_NAME=rotmg-raid-bot
